# Generated at run time — every script rewrites its own outputs.
# NOTE: .gitignore has no inline comments; a trailing "# ..." becomes part of the
# pattern and silently matches nothing. Keep comments on their own lines.

# deploy-pd-guide.sh + calibrate-peak-prefill.sh artifacts
.pd-guide-workspace/

# deploy-pd-guide.sh's default llm-d checkout (LLMD_DIR), cloned fresh on demand
/llm-d/

# launch-scaledobjects.sh render (regenerated every run)
rendered.yaml

# test-metric-flow.sh --probe timelines
timeline-*.csv

# run-benchmark.sh output (GBs per run) and its `latest` symlink
benchmark-results/

# experiment run outputs (reports, timelines, metrics per run)
experiments/
